<Window x:Class="DropShelf.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropShelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <!-- Nearly opaque on purpose. An earlier pass used #EE and page text
             behind the shelf stayed legible through it, which made the card look
             like an artefact rather than an object sitting on top. -->
        <SolidColorBrush x:Key="ShelfBackground" Color="#FA1B1D21" />
        <SolidColorBrush x:Key="ShelfBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="HeaderForeground" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="EmptyForeground" Color="#73FFFFFF" />

        <!-- The hide button is a flat glyph until pointed at. A full button
             chrome would be far too loud on a surface this small. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource HeaderForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin is not padding. AllowsTransparency means the drop shadow is
         drawn inside the window, so the window has to be bigger than the visible
         card or the shadow gets clipped at the edges. -->
    <Border Margin="18"
            CornerRadius="14"
            Background="{StaticResource ShelfBackground}"
            BorderBrush="{StaticResource ShelfBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid Width="260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header, and the only place the window can be dragged from. -->
            <Grid x:Name="Header"
                  Grid.Row="0"
                  Height="30"
                  Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="DropShelf"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HeaderForeground}" />
                <Button Style="{StaticResource HeaderButton}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Hide the shelf"
                        Click="OnHideClick" />
            </Grid>

            <Border Grid.Row="1"
                    MinHeight="92"
                    Margin="10,0,10,10"
                    CornerRadius="9"
                    Background="#0FFFFFFF">
                <TextBlock Text="Drop files here"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource EmptyForeground}" />
            </Border>
        </Grid>
    </Border>
</Window>
