<Window x:Class="DropShelf.Ui.CatcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropShelf catcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="150"
        Height="190">

    <!-- The card is fully opaque, unlike the shelf. It appears on top of whatever
         the user happens to be dragging over, which can be anything at all, and a
         bright photo behind a translucent card washes the label out completely. -->
    <Border x:Name="Card"
            Margin="14"
            CornerRadius="14,0,0,14"
            Background="#FF1B1D21"
            BorderBrush="#33FFFFFF"
            BorderThickness="1,1,0,1"
            AllowDrop="True"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            DragLeave="OnDragLeave"
            Drop="OnDrop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Border x:Name="Target"
                Margin="10"
                CornerRadius="10"
                BorderThickness="1.4"
                BorderBrush="#4DFFFFFF"
                Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8DE;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           Foreground="#B3FFFFFF" />
                <TextBlock Text="Drop to hold"
                           Margin="0,10,0,0"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#B3FFFFFF" />
            </StackPanel>
        </Border>
    </Border>
</Window>
